{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@amk/app-microkernel-api": [
        "libs/app-microkernel-api/src/index.ts"
      ],
      "@amk/app-microkernel-spi": [
        "libs/app-microkernel-spi/src/index.ts"
      ],
      "@amk/app-microkernel-impl": [
        "libs/app-microkernel-impl/src/index.ts"
      ]
    },
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
